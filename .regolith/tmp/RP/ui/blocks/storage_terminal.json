{
    "namespace": "storage_terminal",
    "storage_terminal_top": {
        "type": "collection_panel",
        "anchor_from": "center",
        "anchor_to": "center",
        "size": [ 162, 72 ],
        "offset": [ -10, -40 ],
        "collection_name": "container_items",
        "$item_collection_name": "container_items",
        "controls": [
            // Close Button
            {
                "close_button":{
                    "type": "panel",
                    "anchor_from": "top_right",
                    "anchor_to": "top_right",
                    "offset": [126, -54],
                    "controls": [
                        {
                            "close_button@common.close_button":{
                                "size": [ 12, 12 ],
                                "anchor_from": "center",
                                "anchor_to": "center",
                                "offset": [-22, -2]
                            }
                        }
                    ]
                }
            },
            // Machine Name
            {
                "text_label@chest.chest_label": {
                    "offset": [ 14, -44 ]
                }
            },
            // Terminal Core
            {
                "terminal_core@sh.terminal_core": {
                    "anchor_from": "center",
                    "anchor_to": "center",
                    "offset": [ 0, 57 ]
                }
            },
            // Buttons
            {
                "next_button@sh.button": {
                    "layer": 10,
                    "$index": 168,
                    "$default_texture": "textures/ui/buttons/next/button",
                    "$hover_texture": "textures/ui/buttons/next/selected",
                    "$pressed_texture": "textures/ui/buttons/next/pressed",
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "offset": [ 106, 112 ],
                    "$button_size": [ 22, 22 ]
                }
            },
            {
                "previous_button@sh.button": {
                    "layer": 10,
                    "$index": 167,
                    "$default_texture": "textures/ui/buttons/previous/button",
                    "$hover_texture": "textures/ui/buttons/previous/selected",
                    "$pressed_texture": "textures/ui/buttons/previous/pressed",
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "offset": [ 106, 90 ],
                    "$button_size": [ 22, 22 ]
                }
            },
            {
                "reload_button@sh.button": {
                    "layer": 10,
                    "$index": 166,
                    "$default_texture": "textures/ui/buttons/button",
                    "$hover_texture": "textures/ui/buttons/button_selected",
                    "$pressed_texture": "textures/ui/buttons/button_pressed",
                    "$button_text": "R",
                    "$text_scale": 0.8,
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "offset": [ 106, 68 ],
                    "$button_size": [ 22, 22 ]
                }
            }
        ]
    },
    "utility_panel": {
        "type": "panel",
        "controls": [
            {
                "container_gamepad_helpers@common.container_gamepad_helpers": {}
            },
            {
                "flying_item_renderer@common.flying_item_renderer": { "layer": 14 }
            },
            {
                "selected_item_details_factory@common.selected_item_details_factory": {}
            },
            {
                "item_lock_notification_factory@common.item_lock_notification_factory": {}
            },
            {
                "root_panel@common.root_panel": {
                    "layer": 1,
                    "controls": [
                        {
                            "chest_panel": {
                                "type": "panel",
                                "layer": 5,
                                "controls": [
                                    {
                                        "storage_terminal_background": {
                                            "type": "panel",
                                            "size": [ 196, 194 ],
                                            "anchor_from": "center",
                                            "anchor_to": "center",
                                            "offset": [ 10, -13 ],
                                            "layer": 0,
                                            "controls": [
                                                {
                                                    "image": {
                                                        "type": "image",
                                                        "texture": "textures/ui/background/storage_terminal_bg",
                                                        "size": [ 195, 193 ],
                                                        "anchor_from": "top_left",
                                                        "anchor_to": "top_left",
                                                        "offset": [ 0, 0 ],
                                                        "alpha": 1
                                                    }
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "storage_terminal_top@storage_terminal.storage_terminal_top": {}
                                    },
                                    {
                                        "inventory_panel_bottom_half_with_label@common.inventory_panel_bottom_half_with_label": {}
                                    },
                                    {
                                        "hotbar_grid@common.hotbar_grid_template": {}
                                    },
                                    {
                                        "inventory_take_progress_icon_button@common.inventory_take_progress_icon_button": {}
                                    }
                                ]
                            }
                        },
                        {
                            "inventory_selected_icon_button@common.inventory_selected_icon_button": {}
                        },
                        {
                            "gamepad_cursor@common.gamepad_cursor_button": {}
                        }
                    ]
                }
            }
        ]
    }
