{
  "namespace": "sh",
  "count_column_label": {
    "type": "label",
    "text": "#count_displaying_text",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": [ 18, 378 ],
    "layer": 1,
    "text_alignment": "left",
    "font_scale_factor": "$text_scale",
    "line_padding": "$line_padding",
    "bindings": [
      {
        "binding_name": "#hover_text",
        "binding_name_override": "#count_always_text",
        "binding_condition": "always",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name"
      },
      {
        "binding_name": "#hover_text",
        "binding_name_override": "#count_displaying_text",
        "binding_condition": "visibility_changed",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#count_always_text = #count_displaying_text)",
        "target_property_name": "#count_always_equals_display"
      },
      {
        "binding_name": "#item_id_aux",
        "binding_name_override": "#count_item_aux",
        "binding_condition": "always",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not(#count_item_aux = -1))",
        "target_property_name": "#count_has_item"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#count_always_equals_display or (#count_always_text = '')))",
        "target_property_name": "#visible"
      }
    ]
  },
  "count_label_grid": {
    "type": "collection_panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": [ 162, 378 ],
    "collection_name": "container_items",
    "$item_collection_name": "container_items",
    "$text_scale|default": 0.55,
    "$line_padding|default": 22.725,
    "controls": [
      { "column_001@sh.count_column_label": { "collection_index": "$collection_index_1", "offset": [ 0, -2 ] } },
      { "column_002@sh.count_column_label": { "collection_index": "$collection_index_2", "offset": [ 18, -2 ] } },
      { "column_003@sh.count_column_label": { "collection_index": "$collection_index_3", "offset": [ 36, -2 ] } },
      { "column_004@sh.count_column_label": { "collection_index": "$collection_index_4", "offset": [ 54, -2 ] } },
      { "column_005@sh.count_column_label": { "collection_index": "$collection_index_5", "offset": [ 72, -2 ] } },
      { "column_006@sh.count_column_label": { "collection_index": "$collection_index_6", "offset": [ 90, -2 ] } },
      { "column_007@sh.count_column_label": { "collection_index": "$collection_index_7", "offset": [ 108, -2 ] } },
      { "column_008@sh.count_column_label": { "collection_index": "$collection_index_8", "offset": [ 126, -2 ] } },
      { "column_009@sh.count_column_label": { "collection_index": "$collection_index_9", "offset": [ 144, -2 ] } }
    ],
    "$collection_index_1|default": 169,
    "$collection_index_2|default": 170,
    "$collection_index_3|default": 171,
    "$collection_index_4|default": 172,
    "$collection_index_5|default": 173,
    "$collection_index_6|default": 174,
    "$collection_index_7|default": 175,
    "$collection_index_8|default": 176,
    "$collection_index_9|default": 177
  }
}
