{
  "namespace": "ds",

  "container_slot_button_prototype@common.container_slot_button_prototype": {
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.container_auto_place",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "button.container_auto_place",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_secondary_select",
        "to_button_id": "button.container_auto_place",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.controller_select",
        "to_button_id": "button.container_auto_place",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_auto_place",
        "to_button_id": "button.container_auto_place",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.controller_secondary_select",
        "to_button_id": "button.container_auto_place",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_inventory_drop",
        "to_button_id": "button.container_auto_place",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_inventory_drop_all",
        "to_button_id": "button.container_auto_place",
        "mapping_type": "pressed"
      }
    ]
  },

  // ---------------------------- \\
  // Small Input Slot.            \\
  // ---------------------------- \\

  "small_slot": {
    "type": "input_panel",
    "size": [ 18, 18 ],
    "$cell_image_size|default": [ 18, 18 ],
    "controls": [
      {
        "item@common.container_item": {
          "size": [ 18, 18 ],
          "$cell_image_size": "$cell_image_size"
        }
      }
    ]
  },

  // ---------------------------- \\
  // Medium Input Slot.           \\
  // ---------------------------- \\

  "medium_slot": {
    "type": "input_panel",
    "size": [ 26, 26 ],
    "$cell_image_size|default": [ 22, 22 ],
    "controls": [
      {
        "item@common.container_item": {
          "size": [ 22, 22 ],
          "$cell_image_size": "$cell_image_size"
        }
      }
    ]
  },

  // ---------------------------- \\
  // Large Input Slot.            \\
  // ---------------------------- \\

  "large_slot": {
    "type": "input_panel",
    "size": [ 26, 26 ],
    "$cell_image_size|default": [ 26, 26 ],
    "controls": [
      {
        "item@common.container_item": {
          "size": [ 26, 26 ],
          "$cell_image_size": "$cell_image_size"
        }
      }
    ]
  },

  // ---------------------------- \\
  // prototype small Input Slot.  \\
  // ---------------------------- \\

  "prototype_small_slot": {
    "type": "input_panel",
    "size": [ 18, 18 ],
    "$cell_image_size|default": [ 18, 18 ],
    "controls": [
      {
        "item@common.container_item": {
          "size": [ 18, 18 ],
          "$cell_image_size": "$cell_image_size",
          "$button_ref": "ds.slot_button_prototype"
        }
      }
    ]
  },

  // ---------------------------- \\
  // prototype Medium Input Slot. \\
  // ---------------------------- \\

  "prototype_medium_slot": {
    "type": "input_panel",
    "size": [ 22, 22 ],
    "$cell_image_size|default": [ 22, 22 ],
    "controls": [
      {
        "item@common.container_item": {
          "size": [ 22, 22 ],
          "$cell_image_size": "$cell_image_size",
          "$button_ref": "ds.slot_button_prototype"
        }
      }
    ]
  },

  // ---------------------------- \\
  // prototype Large Input Slot.  \\
  // ---------------------------- \\

  "prototype_large_slot": {
    "type": "input_panel",
    "size": [ 26, 26 ],
    "$cell_image_size|default": [ 26, 26 ],
    "controls": [
      {
        "item@common.container_item": {
          "size": [ 26, 26 ],
          "$cell_image_size": "$cell_image_size",
          "$button_ref": "ds.slot_button_prototype"
        }
      }
    ]
  },

  // ---------------------------- \\
  // Custom Overlay Image .       \\
  // ---------------------------- \\

  "overlay_image": {
    "type": "panel",
    "anchor_from": "center",
    "anchor_to": "center",
    "size": [ 16, 16 ],
    "$texture|default": "textures/ui/overlay",
    "controls": [
      {
        "overlay_image": {
          "type": "image",
          "texture": "$texture",
          "size": [ 16, 16 ]
        }
      }
    ]
  },

  // ---------------------------- \\
  // Custom 2x2 Grid.             \\
  // ---------------------------- \\

  "2x2_grid": {
    "type": "collection_panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": [ 54, 54 ],
    "collection_name": "container_items",
    "$item_collection_name": "container_items",
    "$index_1|default": 0,
    "$is_slot_1|default": true,
    "$index_2|default": 1,
    "$is_slot_2|default": true,
    "$index_3|default": 2,
    "$is_slot_3|default": true,
    "$index_4|default": 3,
    "$is_slot_4|default": true,
    "controls": [
      {
        "slot_1@common.container_item": {
          "visible": "$is_slot_1",
          "collection_index": "$index_1",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 0, 0 ]
        }
      },
      {
        "slot_2@common.container_item": {
          "visible": "$is_slot_2",
          "collection_index": "$index_2",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 18, 0 ]
        }
      },
      {
        "slot_3@common.container_item": {
          "visible": "$is_slot_3",
          "collection_index": "$index_3",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 0, 18 ]
        }
      },
      {
        "slot_4@common.container_item": {
          "visible": "$is_slot_4",
          "collection_index": "$index_4",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 18, 18 ]
        }
      }
    ]
  },

