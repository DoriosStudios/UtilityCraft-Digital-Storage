{
  "namespace": "ds",
  "button": {
    "type": "collection_panel",
    "collection_name": "container_items",
    "$item_collection_name|default": "container_items",
    "size": [ "100%c", "100%c" ],
    "$button_size|default": [ 18, 18 ],
    "$button_text|default": " ",
    "$text_scale|default": 1,
    "$default_texture|default": "textures/ui/buttons/power_button",
    "$hover_texture|default": "textures/ui/buttons/power_button_selected",
    "$pressed_texture|default": "textures/ui/buttons/power_button_pressed",
    "controls": [
      {
        "button": {
          "type": "button",
          "collection_index": "$index",
          "size": "$button_size",
          "default_control": "default",
          "hover_control": "hover",
          "pressed_control": "pressed",
          "sound_name": "random.click",
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "$item_collection_name"
            }
          ],
          "$tag": "",
          "button_mappings": [
            {
              "from_button_id": "button.menu_select",
              "to_button_id": "button.drop_all",
              "mapping_type": "pressed"
            },
            {
              "from_button_id": "button.menu_ok",
              "to_button_id": "button.drop_all",
              "mapping_type": "pressed"
            }
          ],
          "controls": [
            {
              "default": {
                "type": "image",
                "texture": "$default_texture"
              }
            },
            {
              "hover": {
                "type": "image",
                "texture": "$hover_texture"
              }
            },
            {
              "pressed": {
                "type": "image",
                "texture": "$pressed_texture"
              }
            },
            {
              "button_text": {
                "type": "label",
                "layer": 1,
                "text": "$button_text",
                "shadow": true,
                "font_scale_factor": "$text_scale"
              }
            }
          ]
        }
      }
    ]
  }
}