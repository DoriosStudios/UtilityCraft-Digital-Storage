{
  "namespace": "sh",
  "empty_cell": {
    "type": "image",
    "texture": "textures/ui/empty_cell"
  },
  "grid_item_template": {
    "type": "panel",
    "$item_collection_name": "container_items",
    "size": [
      18,
      18
    ],
    "controls": [
      {
        "slot@common.container_item": {
          "$item_collection_name": "$item_collection_name",
          "size": [
            18,
            18
          ],
          "layer": 1,
          "$cell_image_size|default": [
            18,
            18
          ],
          "$cell_overlay_ref|default": "common.cell_overlay",
          "$button_ref": "sh.virtual_slot_button_prototype",
          "$background_images": "sh.empty_cell",
          "$stack_count_required|default": false,
          "$durability_bar_required|default": true,
          "$storage_bar_required|default": true,
          "$item_renderer|default": "common.item_renderer",
          "$item_renderer_panel_size|default": [
            18,
            18
          ],
          "$item_renderer_size|default": [
            16,
            16
          ],
          "$item_renderer_offset|default": [
            0,
            0
          ],
          "$focus_id|default": "",
          "$focus_override_down|default": "",
          "$focus_override_up|default": "",
          "$focus_override_left|default": "",
          "$focus_override_right|default": "",
          "focus_identifier": "$focus_id",
          "focus_change_down": "$focus_override_down",
          "focus_change_up": "$focus_override_up",
          "focus_change_left": "$focus_override_left",
          "focus_change_right": "$focus_override_right",
          "focus_enabled": true,
          "focus_wrap_enabled": false,
          "focus_magnet_enabled": true
        }
      },
      {
        "virtual_count_label": {
          "type": "label",
          "text": "#virtual_count_label_text",
          "anchor_from": "bottom_right",
          "anchor_to": "bottom_right",
          "offset": [
            -1.5,
            -1.5
          ],
          "layer": 29,
          "color": [
            1,
            1,
            1
          ],
          "shadow": true,
          "max_size": [
            "100%c",
            "100%c"
          ],
          "contained": true,
          "text_alignment": "right",
          "font_scale_factor": 0.5,
          "bindings": [
            {
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name",
              "binding_name": "#hover_text",
              "binding_name_override": "#virtual_hover_text",
              "binding_condition": "always"
            },
            {
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name",
              "binding_name": "#item_id_aux",
              "binding_name_override": "#virtual_item_aux",
              "binding_condition": "always"
            },
            {
              "binding_type": "view",
              "source_property_name": "((not (#virtual_item_aux = -1)) and not ((#virtual_hover_text - '§0§9§0§f') = #virtual_hover_text))",
              "target_property_name": "#visible"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#virtual_hover_text - '§0§9§0§f' - '§r' - '§f' - '§o' - '§7' - '§8')",
              "target_property_name": "#virtual_count_clean"
            },
            {
              "binding_type": "view",
              "source_property_name": "('§r' + ((#virtual_count_clean * '%.6s') - 'a'))",
              "target_property_name": "#virtual_count_label_text"
            }
          ]
        }
      },
      {
        "search_overlay": {
          "type": "image",
          "texture": "textures/ui/overlay/search_overlay",
          "alpha": 0.9,
          "layer": 28,
          "size": [
            "18px",
            "18px"
          ],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "search_box_text_control",
              "source_property_name": "#item_name",
              "target_property_name": "#edit_box_input"
            },
            {
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name",
              "binding_name": "#hover_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "((#hover_text - #edit_box_input) = #hover_text and not (#edit_box_input = ''))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },
  "storage_grid_scroll_content": {
    "type": "panel",
    "size": [
      "100%",
      450
    ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "storage_grid": {
          "type": "grid",
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [
            0,
            0
          ],
          "grid_dimensions": [
            9,
            25
          ],
          "maximum_grid_items": 225,
          "collection_name": "container_items",
          "grid_item_template": "sh.grid_item_template",
          "layer": 2
        }
      }
    ]
  },
  "terminal_core": {
    "type": "collection_panel",
    "collection_name": "container_items",
    "$item_collection_name": "container_items",
    "anchor_from": "center",
    "anchor_to": "center",
    "size": [
      162,
      72
    ],
    "offset": [
      0,
      0
    ],
    "$burn_index|default": 227,
    "controls": [
      {
        "search_bar@common.text_edit_box": {
          "size": [
            143,
            18
          ],
          "offset": [
            21.5,
            -113
          ],
          "anchor_from": "center",
          "anchor_to": "center",
          "layer": 5,
          "max_length": 32,
          "$text_box_name": "search_box",
          "$text_edit_text_control": "search_box_text_control",
          "$magnifying_glass_enabled": true,
          "$magnifying_glass_size": [
            8,
            8
          ],
          "$magnifying_glass_offset": [
            0,
            -0.5
          ],
          "$text_edit_box_label_offset": [
            10,
            0
          ],
          "$place_holder_text": "Search..."
        }
      },
      {
        "burn_slot@sh.small_slot": {
          "$item_collection_name": "$item_collection_name",
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [
            -62,
            -86
          ],
          "collection_index": "$burn_index"
        }
      },
      {
        "burn_slot_overlay": {
          "type": "image",
          "texture": "textures/ui/overlay/burn_slot_overlay",
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "size": [
            12,
            12
          ],
          "offset": [
            -62,
            -83
          ],
          "layer": 4
        }
      },
      {
        "storage_slots": {
          "type": "panel",
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [
            10,
            -65
          ],
          "size": [
            162,
            72
          ],
          "controls": [
            {
              "scrolling_panel@sh.scrolling_panel": {
                "size": [
                  162,
                  72
                ],
                "$scroll_view_port_size": [
                  162,
                  72
                ],
                "$scrolling_content": "sh.storage_grid_scroll_content"
              }
            }
          ]
        }
      }
    ]
  }
}
