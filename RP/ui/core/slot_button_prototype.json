{
    "namespace": "sh",
    "highlight_slot_panel": {
        "type": "panel",
        "controls": [
            {
                "highlight@common.highlight_slot": {
                    "layer": 40,
                    "controls": [
                        {
                            "hover_text": {
                                "type": "custom",
                                "renderer": "hover_text_renderer",
                                "allow_clipping": false,
                                "layer": 41,
                                "property_bag": {
                                    "#hover_text": "#hover_text"
                                },
                                "bindings": [
                                    {
                                        "binding_type": "collection_details",
                                        "binding_collection_name": "$item_collection_name"
                                    },
                                    {
                                        "binding_name": "#hover_text",
                                        "binding_type": "collection",
                                        "binding_collection_name": "$item_collection_name",
                                        "binding_condition": "none"
                                    },
                                    {
                                        "binding_type": "view",
                                        "source_property_name": "(#hover_text)",
                                        "target_property_name": "#visible"
                                    }
                                ]
                            }
                        }
                    ],
                    "bindings": [
                        {
                            "binding_name": "#show_persistent_bundle_hover_text",
                            "binding_name_override": "#visible"
                        }
                    ]
                }
            },
            {
                "white_border@common.white_border_slot": {
                "layer": 40,
                "bindings": [
                        {
                            "binding_name": "#show_persistent_bundle_hover_text",
                            "binding_name_override": "#visible"
                        }
                    ]
                }
            }
        ]
    },

    "virtual_highlight_slot_panel": {
        "type": "panel",
        "controls": [
            {
                "highlight@common.highlight_slot": {
                    "layer": 40,
                    "controls": [
                        {
                            "hover_text@common.hover_text": {
                                "layer": 41,
                                "$hover_text_binding_name|default": "#hover_text",
                                "property_bag": {
                                    "#test": "test"
                                },
                                "bindings": [
                                    {
                                        "binding_name": "#hover_text",
                                        "binding_name_override": "#text",
                                        "binding_type": "collection",
                                        "binding_collection_name": "$item_collection_name"
                                    },
                                    {
                                        "binding_name": "#item_id_aux",
                                        "binding_name_override": "#aux",
                                        "binding_condition": "always",
                                        "binding_type": "collection",
                                        "binding_collection_name": "$item_collection_name"
                                    },
                                    {
                                        "binding_type": "view",
                                        "source_property_name": "((not(#aux = -1)) and not ((#text - '§0§9§0§f') = #text))",
                                        "target_property_name": "#is_virtual_item"
                                    },
                                    {
                                        "binding_type": "view",
                                        "source_property_name": "#is_virtual_item",
                                        "target_property_name": "#visible"
                                    },
                                    {
                                        "binding_type": "view",
                                        "source_property_name": "('§r' + (#text - ('%.58s' * #text)))",
                                        "target_property_name": "#hover_text"
                                    }
                                ]
                            }
                        }
                    ],
                    "bindings": [
                        {
                            "binding_name": "#show_persistent_bundle_hover_text",
                            "binding_name_override": "#visible"
                        }
                    ]
                }
            },
            {
                "white_border@common.white_border_slot": {
                "layer": 40,
                "bindings": [
                        {
                            "binding_name": "#show_persistent_bundle_hover_text",
                            "binding_name_override": "#visible"
                        }
                    ]
                }
            }
        ]
    },

    "virtual_slot_button_prototype@common.container_slot_button_prototype": {
        "$highlight_control": "sh.virtual_highlight_slot_panel",
        "button_mappings": [
            {
                "from_button_id": "button.menu_select",
                "to_button_id": "button.container_auto_place",
                "mapping_type": "pressed"
            },
            {
                "from_button_id": "button.menu_ok",
                "to_button_id": "button.container_auto_place",
                "mapping_type": "pressed"
            },
            {
                "from_button_id": "button.menu_auto_place",
                "to_button_id": "button.container_auto_place",
                "mapping_type": "pressed"
            }
        ]
    },

    "slot_button_prototype@common.container_slot_button_prototype": {
        "$highlight_control": "sh.highlight_slot_panel",
        "button_mappings": [
            {
                "from_button_id": "button.menu_select",
                "to_button_id": "button.container_auto_place",
                "mapping_type": "pressed"
            },
            {
                "from_button_id": "button.menu_ok",
                "to_button_id": "button.container_auto_place",
                "mapping_type": "pressed"
            },
            {
                "from_button_id": "button.menu_auto_place",
                "to_button_id": "button.container_auto_place",
                "mapping_type": "pressed"
            }
        ]
    }
}
