{
  "namespace": "sh",
  "count_column_label": {
    "type": "label",
    "text": "#hover_text",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": [
      18,
      432
    ],
    "layer": 1,
    "text_alignment": "left",
    "font_scale_factor": "$text_scale",
    "line_padding": "$line_padding",
    "bindings": [
      {
        "binding_name": "#hover_text",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name"
      }
    ]
  },
  "count_label_grid": {
    "type": "collection_panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": [
      162,
      216
    ],
    "collection_name": "container_items",
    "$item_collection_name": "container_items",
    "$text_scale|default": 0.55,
    "$line_padding|default": 22.6,
    "controls": [
      {
        "column_001@sh.count_column_label": {
          "collection_index": "$collection_index_1",
          "offset": [
            0,
            -2
          ]
        }
      },
      {
        "column_002@sh.count_column_label": {
          "collection_index": "$collection_index_2",
          "offset": [
            18,
            -2
          ]
        }
      },
      {
        "column_003@sh.count_column_label": {
          "collection_index": "$collection_index_3",
          "offset": [
            36,
            -2
          ]
        }
      },
      {
        "column_004@sh.count_column_label": {
          "collection_index": "$collection_index_4",
          "offset": [
            54,
            -2
          ]
        }
      },
      {
        "column_005@sh.count_column_label": {
          "collection_index": "$collection_index_5",
          "offset": [
            72,
            -2
          ]
        }
      },
      {
        "column_006@sh.count_column_label": {
          "collection_index": "$collection_index_6",
          "offset": [
            90,
            -2
          ]
        }
      },
      {
        "column_007@sh.count_column_label": {
          "collection_index": "$collection_index_7",
          "offset": [
            108,
            -2
          ]
        }
      },
      {
        "column_008@sh.count_column_label": {
          "collection_index": "$collection_index_8",
          "offset": [
            126,
            -2
          ]
        }
      },
      {
        "column_009@sh.count_column_label": {
          "collection_index": "$collection_index_9",
          "offset": [
            144,
            -2
          ]
        }
      }
    ],
    "$collection_index_1|default": 108,
    "$collection_index_2|default": 109,
    "$collection_index_3|default": 110,
    "$collection_index_4|default": 111,
    "$collection_index_5|default": 112,
    "$collection_index_6|default": 113,
    "$collection_index_7|default": 114,
    "$collection_index_8|default": 115,
    "$collection_index_9|default": 116
  }
}