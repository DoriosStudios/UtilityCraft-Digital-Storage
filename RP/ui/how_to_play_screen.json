      },
      {
        "transfer_header@how_to_play.ds_header": {
          "$text": "howtoplay.digital_storage.getting_started.expansion.h1"
        }
      },
      {
        "transfer_text@how_to_play.ds_wide_paragraph": {
          "$text": "howtoplay.digital_storage.getting_started.expansion.p1"
        }
      },
      {
        "transfer_station@how_to_play.ds_machine_render": {
          "$machine_texture": "textures/ui/wiki/digital_storage/guide/storage_transfer_station"
        }
      },
      {
        "buffers_text@how_to_play.ds_wide_paragraph": {
