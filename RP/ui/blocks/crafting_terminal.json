{
    "namespace": "crafting_terminal",
    "crafting_terminal_top": {
        "type": "collection_panel",
        "anchor_from": "center",
        "anchor_to": "center",
        "size": [ 162, 72 ],
        "offset": [ -10, -40 ],
        "collection_name": "container_items",
        "$item_collection_name": "container_items",
        "controls": [
            // Close Button
            {
                "close_button":{
                    "type": "panel",
                    "anchor_from": "top_right",
                    "anchor_to": "top_right",
                    "offset": [127, -54],
                    "controls": [
                        {
                            "close_button@common.close_button":{
                                "size": [ 12, 12 ],
                                "anchor_from": "center",
                                "anchor_to": "center",
                                "offset": [-22, -2]
                            }
                        }
                    ]
                }
            },
            // Machine Name
            {
                "text_label@chest.chest_label": {
                    "offset": [ 14, -44 ]
                }
            },
            // Terminal Core
            {
                "terminal_core@sh.terminal_core": {
                    "anchor_from": "center",
                    "anchor_to": "center",
                    "offset": [ 0, 57 ]
                }
            },
            // Next Button
            {
                "next_button@sh.button": {
                    "layer": 10,
                    "$index": 219,
                    "$button_size": [22, 22],
                    "$default_texture": "textures/ui/buttons/next/button",
                    "$hover_texture": "textures/ui/buttons/next/selected",
                    "$pressed_texture": "textures/ui/buttons/next/pressed",
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "offset": [ 106, 134 ]
                }
            },
            // Previous Button
            {
                "previous_button@sh.button": {
                    "layer": 10,
                    "$index": 220,
                    "$button_size": [22, 22],
                    "$default_texture": "textures/ui/buttons/previous/button",
                    "$hover_texture": "textures/ui/buttons/previous/selected",
                    "$pressed_texture": "textures/ui/buttons/previous/pressed",
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "offset": [ 106, 112 ]
                }
            },
            // Quantity Button
            {
                "quantity_button@sh.button": {
                    "layer": 10,
                    "$index": 221,
                    "$default_texture": "textures/ui/buttons/quantity/button",
                    "$hover_texture": "textures/ui/buttons/quantity/selected",
                    "$pressed_texture": "textures/ui/buttons/quantity/pressed",
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "offset": [ 106, 90 ],
                    "$button_size": [ 22, 22 ]
                }
            },
            // Sort Button
            {
                "sort_button@sh.button": {
                    "layer": 10,
                    "$index": 222,
                    "$default_texture": "textures/ui/buttons/sort/button",
                    "$hover_texture": "textures/ui/buttons/sort/selected",
                    "$pressed_texture": "textures/ui/buttons/sort/pressed",
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "offset": [ 106, 68 ],
                    "$button_size": [ 22, 22 ]
                }
            },
            {
                "crafting_toggle@sh.toggle_button": {
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "offset": [ -90, -33 ],
                    "$toggle_size": [ 17, 17 ],
                    "$toggle_layer": 7,
                    "$toggle_index": 0,
                    "$toggle_group": false,
                    "$toggle_lost_reset": true,
                    "$toggle_default_state": false,
                    "$toggle_control_name": "crafting_toggle_button",
                    "$toggle_unchecked": "textures/ui/buttons/crafting/unchecked",
                    "$toggle_checked": "textures/ui/buttons/crafting/checked",
                    "$toggle_unchecked_hover": "textures/ui/buttons/crafting/unchecked_hover",
                    "$toggle_checked_hover": "textures/ui/buttons/crafting/checked_hover"
                }
            },
            {
                "crafting_state_panel@sh.toggle_button_panel": {
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "offset": [ 0, 0 ],
                    "size": [ 162, 72 ],
                    "$panel_control_name": "crafting_toggle_button",
                    "$controls": [
                        {
                            "crafting_tab_background": {
                                "type": "image",
                                "texture": "textures/ui/background/crafting_terminal_tab",
                                "size": [ 103, 169 ],
                                "offset": [ -129, -10 ],
                                "anchor_from": "top_middle",
                                "anchor_to": "top_middle",
                                "layer": -6
                            }
                        },
                        {
                            "crafting_panel@sh.crafting_panel": {
                                "offset": [ -114, -32 ],
                                "$quantity_index": 223,
                                "$remove_index": 224,
                                "$blueprint_index": 225,
                                "$grid_index_1": 226,
                                "$grid_index_2": 227,
                                "$grid_index_3": 228,
                                "$grid_index_4": 229,
                                "$grid_index_5": 230,
                                "$grid_index_6": 231,
                                "$grid_index_7": 232,
                                "$grid_index_8": 233,
                                "$grid_index_9": 234,
                                "$output_index": 235,
                                "$craft_index": 236,
                                "$mode_index": 237
                            }
                        },
                        {
                            "crafting_title": {
                                "type": "label",
                                "text": "ui.utilitycraft:crafting_label",
                                "size": [ 80, 10 ],
                                "text_alignment": "left",
                                "anchor_from": "top_left",
                                "anchor_to": "top_middle",
                                "offset": [ -54, -6 ],
                                "color": [ 0.3, 0.3, 0.3 ],
                                "layer": 1
                            }
                        },
                        {
                            "output_mode_title": {
                                "type": "label",
                                "text": "Output Mode",
                                "size": [ 80, 10 ],
                                "text_alignment": "left",
                                "anchor_from": "top_left",
                                "anchor_to": "top_middle",
                                "offset": [ -52, 93 ],
                                "color": [ 0.3, 0.3, 0.3 ],
                                "layer": 1
                            }
                        }
                    ]
                }
            },
            {
                "button_background": {
                    "type": "image",
                    "texture": "textures/ui/buttons/button_background",
                    "size": [ 26, 27 ],
                    "offset": [ -90, -10.5 ],
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "layer": -6,
                    "bindings": [
                        {
                            "binding_type": "view",
                            "source_control_name": "crafting_toggle_button",
                            "source_property_name": "(not (#toggle_state))",
                            "target_property_name": "#visible",
                            "resolve_sibling_scope": false
                        }
                    ]
                }
            }
        ]
    },
    "utility_panel": {
