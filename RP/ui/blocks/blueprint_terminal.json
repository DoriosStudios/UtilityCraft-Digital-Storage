                    "collection_index": 228,
                    "anchor_from": "top_left",
                    "anchor_to": "top_left",
                    "$text_scale": 0.55,
                    "offset": [ 14, 12 ]
                }
            },
            // Info Panel Background
            {
                "info_panel_background@uc.machine_small_screen": {}
            }
