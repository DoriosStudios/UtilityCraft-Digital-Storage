{
    "namespace": "blueprint_terminal",
    "blueprint_terminal_top": {
        "type": "collection_panel",
        "anchor_from": "center",
        "anchor_to": "center",
        "size": [ 162, 72 ],
        "offset": [ -10, -40 ],
        "collection_name": "container_items",
        "$item_collection_name": "container_items",
        "controls": [
            // Close Button
            {
                "close_button":{
                    "type": "panel",
                    "anchor_from": "top_right",
                    "anchor_to": "top_right",
                    "offset": [100, -61],
                    "controls": [
                        {
                            "close_button@common.close_button":{
                                "size": [ 12, 12 ],
                                "anchor_from": "center",
                                "anchor_to": "center",
                                "offset": [-22, -2]
                            }
                        }
                    ]
                }
            },
            // Search Bar Background
            {
                "search_bar_bg": {
                    "type": "image",
                    "texture": "textures/ui/background/background_panel",
                    "size": [ 162, 31 ],
                    "offset": [ 10, -41 ],
                    "anchor_from": "top_right",
                    "anchor_to": "top_right",
                    "layer": 0
                }
            },
            // Machine Name
            {
                "text_label@chest.chest_label": {
                    "offset": [ 14, -52 ]
                }
            },
            // Terminal Core
            {
                "terminal_core@sh.terminal_core": {
                    "anchor_from": "center",
                    "anchor_to": "center",
                    "offset": [ 0, 57 ]
                }
            },
            // Next Button
            {
                "next_button@uc.machine_button": {
                    "layer": 10,
                    "$index": 219,
                    "$button_size": [22, 22],
                    "$default_texture": "textures/ui/buttons/next/button",
                    "$hover_texture": "textures/ui/buttons/next/selected",
                    "$pressed_texture": "textures/ui/buttons/next/pressed",
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "offset": [ 106, 134 ]
                }
            },
            // Previous Button
            {
                "previous_button@uc.machine_button": {
                    "layer": 10,
                    "$index": 220,
                    "$button_size": [22, 22],
                    "$default_texture": "textures/ui/buttons/previous/button",
                    "$hover_texture": "textures/ui/buttons/previous/selected",
                    "$pressed_texture": "textures/ui/buttons/previous/pressed",
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "offset": [ 106, 112 ]
                }
            },
            // Quantity Button
            {
                "quantity_button@uc.machine_button": {
                    "layer": 10,
                    "$index": 221,
                    "$default_texture": "textures/ui/buttons/quantity/button",
                    "$hover_texture": "textures/ui/buttons/quantity/selected",
                    "$pressed_texture": "textures/ui/buttons/quantity/pressed",
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "offset": [ 106, 90 ],
                    "$button_size": [ 22, 22 ]
                }
            },
            // Sort Button
            {
                "sort_button@uc.machine_button": {
                    "layer": 10,
                    "$index": 222,
                    "$default_texture": "textures/ui/buttons/sort/button",
                    "$hover_texture": "textures/ui/buttons/sort/selected",
                    "$pressed_texture": "textures/ui/buttons/sort/pressed",
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "offset": [ 106, 68 ],
                    "$button_size": [ 22, 22 ]
                }
            },
            {
                "blueprint_toggle@sh.toggle_button": {
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "offset": [ -90, -27 ],
                    "$toggle_size": [ 17, 17 ],
                    "$toggle_layer": 7,
                    "$toggle_index": 0,
                    "$toggle_group": false,
                    "$toggle_lost_reset": true,
                    "$toggle_default_state": false,
                    "$toggle_control_name": "blueprint_toggle_button",
                    "$toggle_unchecked": "textures/ui/buttons/crafting/unchecked",
                    "$toggle_checked": "textures/ui/buttons/crafting/checked",
                    "$toggle_unchecked_hover": "textures/ui/buttons/crafting/unchecked_hover",
                    "$toggle_checked_hover": "textures/ui/buttons/crafting/checked_hover"
                }
            },
            {
                "blueprint_state_panel@sh.toggle_button_panel": {
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "offset": [ 0, 0 ],
                    "size": [ 162, 72 ],
                    "$panel_control_name": "blueprint_toggle_button",
                    "$controls": [
                        {
                            "blueprint_panel@sh.blueprint_panel": {
                                "offset": [ -104, 10 ],
                                "$blueprint_index": 223,
                                "$output_index": 224,
                                "$info_index": 225,
                                "$quantity_index": 226
                            }
                        },
                        {
                            "blueprint_background": {
                                "type": "image",
                                "texture": "textures/ui/background/background_panel",
                                "size": [ 120, 120 ],
                                "offset": [ -144, -6 ],
                                "anchor_from": "top_right",
                                "anchor_to": "top_right",
                                "layer": -6
                            }
                        },
                        {
                            "blueprint_title": {
                                "type": "label",
                                "text": "ui.utilitycraft:blueprint_label",
                                "anchor_from": "top_middle",
                                "anchor_to": "top_middle",
                                "offset": [-140, 4],
                                "color": [ 0.3, 0.3, 0.3 ],
                                "layer": 1
                            }
                        }
                    ]
                }
            },
            {
                "button_background": {
                    "type": "image",
                    "texture": "textures/ui/buttons/button_background",
                    "size": [ 26, 27 ],
                    "offset": [ -90, -4.5 ],
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "layer": -6,
                    "bindings": [
                        {
                            "binding_type": "view",
                            "source_control_name": "blueprint_toggle_button",
                            "source_property_name": "(not (#toggle_state))",
                            "target_property_name": "#visible",
                            "resolve_sibling_scope": false
                        }
                    ]
                }
            }
        ]
    },
    "utility_panel": {
        "type": "panel",
        "controls": [
            {
                "container_gamepad_helpers@common.container_gamepad_helpers": { }
            },
            {
                "flying_item_renderer@common.flying_item_renderer": { "layer": 14 }
            },
            {
                "selected_item_details_factory@common.selected_item_details_factory": {}
            },
            {
                "item_lock_notification_factory@common.item_lock_notification_factory": {}
            },
            {
                "root_panel@common.root_panel": {
                    "layer": 1,
                    "controls": [
                        {
                            "common_panel@common.common_panel": {}
                        },
                        {
                            "chest_panel": {
                                "type": "panel",
                                "layer": 5,
                                "controls": [
                                    {
                                        "blueprint_terminal_top@blueprint_terminal.blueprint_terminal_top": { }
                                    },
                                    {
                                        "inventory_panel_bottom_half_with_label@common.inventory_panel_bottom_half_with_label": {}
                                    },
                                    {
                                        "hotbar_grid@common.hotbar_grid_template": { }
                                    },
                                    {
                                        "inventory_take_progress_icon_button@common.inventory_take_progress_icon_button": { }
                                    }
                                ]
                            }
                        },
                        {
                            "inventory_selected_icon_button@common.inventory_selected_icon_button": { }
                        },
                        {
                            "gamepad_cursor@common.gamepad_cursor_button": { }
                        }
                    ]
                }
            }
        ]
    }
}
