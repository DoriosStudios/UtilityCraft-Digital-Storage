{
	"format_version": "1.19.20",
	"minecraft:entity": {
		"description": {
			"identifier": "utilitycraft:export_buffer",
			"is_spawnable": false,
			"is_summonable": true,
			"is_experimental": false,
			"properties": {
                "utilitycraft:selection_empty": { "type": "bool", "default": false },
                "utilitycraft:orphan_cleanup": { "type": "bool", "default": false },
				"utilitycraft:players": {
					"type": "int",
					"default": 0,
					"range": [
						0,
						100
					]
				},
				"utilitycraft:tick_group": {
					"type": "int",
					"default": 0,
					"range": [
						0,
						5
					]
				}
			}
		},
		"component_groups": {
            "utilitycraft:selection_full": {"minecraft:collision_box":{"height":1,"width":1}},
            "utilitycraft:selection_empty": {"minecraft:collision_box":{"height":0,"width":0}},
			"despawn": {
				"minecraft:instant_despawn": {}
			},
			"utilitycraft:inventory_setup": {
				"minecraft:inventory": {
					"inventory_size": 37,
					"container_type": "container"
				}
			}
		},
		"components": {
			"minecraft:type_family": {
				"family": [
					"utilitycraft:block_container",
					"inanimate",
					"dorios:machine",
					"dorios:container",
					"dorios:special_container"
				]
			},
			"minecraft:health": {
				"max": 1,
				"value": 1
			},
			"minecraft:damage_sensor": {
				"triggers": [
					{
						"cause": "all",
						"deals_damage": false
					}
				]
			},
			"minecraft:knockback_resistance": {
				"value": 1000
			},
			"minecraft:fire_immune": true,
			"minecraft:inventory": {
				"inventory_size": 37,
				"container_type": "container"
			},
			"minecraft:collision_box": {
				"height": 1,
				"width": 1
			}
		},
		"events": {
            "utilitycraft:selection_full": {"set_property":{"utilitycraft:selection_empty":false},"remove":{"component_groups":["utilitycraft:selection_empty"]},"add":{"component_groups":["utilitycraft:selection_full"]}},
            "utilitycraft:selection_empty": {"set_property":{"utilitycraft:selection_empty":true},"remove":{"component_groups":["utilitycraft:selection_full"]},"add":{"component_groups":["utilitycraft:selection_empty"]}},
			"despawn": {
				"add": {
					"component_groups": [
						"despawn"
					]
				}
			},
			"utilitycraft:setup_inventory": {
				"add": {
					"component_groups": [
						"utilitycraft:inventory_setup"
					]
				}
			}
		}
	}
}
